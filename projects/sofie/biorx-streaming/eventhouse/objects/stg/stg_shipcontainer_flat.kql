    route_id: long,
    packed_by_id: long,
    packed_date: datetime,
    packed_time: timespan,
    delivery_number: string,
    status: string,
    shipment_id: long,
    container_id: long,
    returned: int,
    returned_date: datetime,
    returned_time: timespan,
    returned_by_id: long,
    delivered_shipment_id: long,
    delivered_date: datetime,
