.create-or-alter function with
(
    folder = "CDC",
    docstring = "Flattens raw_shipment MariaDB CDC payloads"
)
func_stg_shipment_flat()
{
    raw_shipment
    | extend p = todynamic(payload)
    | where tostring(p.source.table) == "shipment"
    | where tostring(p.op) in ("r", "c", "u", "d")
    | extend row_data = coalesce(
        todynamic(p.after),
        todynamic(p.before)
    )
    | project
        cdc_operation = tostring(p.op),

        cdc_event_datetime =
            unixtime_milliseconds_todatetime(
                tolong(p.ts_ms)
            ),

        source_event_datetime =
            unixtime_milliseconds_todatetime(
                tolong(p.source.ts_ms)
            ),

        ts_ns = coalesce(
            tolong(p.ts_ns),
            tolong(p.ts_ms) * 1000000
        ),

        is_deleted =
            tostring(p.op) == "d"
            or toint(row_data.Deleted) == 1,

        shipment_id = tolong(row_data.ShipmentID),
        shipped = toint(row_data.Shipped),
        shipped_by_id = tolong(row_data.ShippedByID),

        ship_date =
            datetime(1970-01-01)
            + tolong(row_data.ShipDate) * 1d,

        ship_time =
            tolong(row_data.ShipTime) / 1000 * 1ms,

        delivered = toint(row_data.Delivered),
        driver_id = tolong(row_data.DriverID),

        delivery_date =
            datetime(1970-01-01)
            + tolong(row_data.DeliveryDate) * 1d,

        delivery_time =
            tolong(row_data.DeliveryTime) / 1000 * 1ms,

        received_by = tostring(row_data.ReceivedBy),
        deleted = toint(row_data.Deleted),
        location_guid = tostring(row_data.LocationGUID)
}