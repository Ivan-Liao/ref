.create-or-alter function with (
    docstring = "Orders calibrated between _from and _to, optionally filtered by client/location/product",
    folder = "Reporting"
)
func_order_details_dev(
    _from:string = "",
    _to:string = "",
    _pharmacy:string = "",
    _order_status:string = "",
    _client:string = "",
    _product:string = ""
) {
    // ------------------------------------------------------------
    // 1. PARAMETERS
    // ------------------------------------------------------------

    let _from_resolved = iff(_from == "", startofday(now(-30d)), todatetime(_from));
    let _to_resolved = iff(_to == "", startofday(now(+30d)), todatetime(_to));
    let _pharmacy_list = iff(_pharmacy == "", dynamic([]), todynamic(_pharmacy));
    let _client_list = iff(_client == "", dynamic([]), todynamic(_client));
    let _product_list = iff(_product == "", dynamic([]), todynamic(_product));
    let _order_status_list = iff(_order_status == "", dynamic([]), todynamic(_order_status));


    // ------------------------------------------------------------
    // 2. DIMENSION DATASETS
    // ------------------------------------------------------------

    let reasons =
        materialized_view('mv_reason_latest')
        | project
            reason_ordered_id = record_id,
            location_guid,
            reason_code_id,
            reason_dt = dt;

    let reasoncodes =
        materialized_view('mv_reasoncode_latest')
        | project
            reason_code_id,
            code,
            description;

    let current_reason =
        reasons
        | lookup kind=leftouter reasoncodes on reason_code_id
        | project
            reason_ordered_id,
            location_guid,
            code,
            description,
            reason_dt;

    let sites =
        materialized_view('mv_locations_latest')
        | project
            location_guid,
            location_name;

    let products =
        materialized_view('mv_product_latest')
        | project
            product_id,
            product_name = name;

    let clients =
        materialized_view('mv_client_latest')
        | project
            client_id,
            client_name = name;

    let containers =
        materialized_view('mv_shipcontainer_latest')
        | project
            ship_container_id,
            shipment_id,
            packed_date,
            packed_time,
            delivered_shipment_id,
            delivered_date,
            delivered_time,
            location_guid;

    let shipments =
        materialized_view('mv_shipment_latest')
        | project
            shipment_id,
            ship_date,
            ship_time,
            location_guid;


    // ------------------------------------------------------------
    // 3. REDIRECT DATASETS
    // ------------------------------------------------------------

    // Read and project the ordered dataset once for both redirect
    // relationships.

    let ordered_redirect_links =
        materialized_view('mv_ordered_latest_dev')
        | project
            ordered_id,
            calibration_dt,
            location_guid;

    let ordered_link_redirect_sent =
        ordered_redirect_links
        | project
            link_redirect_sent_ordered_id = ordered_id,
            link_redirect_sent_calibration_dt = calibration_dt,
            link_redirect_sent_location_guid = location_guid;

    let ordered_link_redirect_received =
        ordered_redirect_links
        | project
            link_redirect_received_ordered_id = ordered_id,
            link_redirect_received_calibration_dt = calibration_dt,
            link_redirect_received_location_guid = location_guid;

    // Read and project redirect relationships once.

    let ordered_redirects =
        materialized_view('mv_orderedredirect_latest')
        | project
            ordered_id,
            exchanged_id;

    let orderedredirect_sent =
        ordered_redirects
        | project
            sent_ordered_id = ordered_id,
            sent_exchanged_id = exchanged_id;

    let orderedredirect_received =
        ordered_redirects
        | project
            received_ordered_id = ordered_id,
            exchanged_id;

    // Reuse the location dataset for redirect locations.

    let redirect_received_sites =
        sites
        | project
            link_redirect_received_location_guid = location_guid,
            received_facility_name = location_name;

    let redirect_sent_sites =
        sites
        | project
            link_redirect_sent_location_guid = location_guid,
            sent_facility_name = location_name;


    // ------------------------------------------------------------
    // 4. BASE ORDERS
    // ------------------------------------------------------------

    // Restrict orders to the requested calibration date range.
    // Materialize because this dataset is reused below.

    let orders_base =
        materialize(
            materialized_view('mv_ordered_latest_dev')
            | where calibration_date between (_from_resolved .. _to_resolved)
            | extend is_recalibrated =
                iff(min_calibration_dt != max_calibration_dt, "Yes", "No")
        );

    let recal_ids =
        orders_base
        | where is_recalibrated == "Yes"
        | project ordered_id;


    // ------------------------------------------------------------
    // 5. RECALIBRATION HISTORY
    // ------------------------------------------------------------

    // Retrieve history only for recalibrated orders.
    // Project only columns required by the history calculations.

    let history =
        materialize(
            stg_ordered_flat
            | where is_deleted == false
            | join kind=leftsemi (recal_ids) on ordered_id
            | project
                ordered_id,
                calibration_date,
                calibration_time,
                last_modified,
                ts_ns
            | extend calibration_dt =
                calibration_date + calibration_time
            | sort by
                ordered_id asc,
                last_modified asc,
                ts_ns asc
            | serialize
            | extend prev_calibration_dt =
                iff(
                    prev(ordered_id) == ordered_id,
                    prev(calibration_dt),
                    datetime(null)
                )
        );

    // Identify orders where a calibration change occurred on
    // the same day that the change was recorded.

    let same_day_ids =
        history
        | where isnotnull(prev_calibration_dt)
        | where calibration_dt != prev_calibration_dt
        | where calibration_date == startofday(last_modified)
        | distinct ordered_id
        | extend is_recalibrated_same_day = "Yes";

    // Generate chronological calibration history.
    // Retain only the earliest recorded timestamp for each
    // distinct calibration datetime.

    let recal_history =
        history
        | summarize first_recorded = min(last_modified)
            by ordered_id, calibration_dt
        | sort by
            ordered_id asc,
            first_recorded asc,
            calibration_dt asc
        | summarize recalibration_history =
            strcat_array(
                make_list(
                    format_datetime(calibration_dt, "yyyy-MM-dd HH:mm:ss")
                ),
                ", "
            )
            by ordered_id;

    let recal_info =
        recal_history
        | join kind=leftouter (same_day_ids) on ordered_id
        | project
            ordered_id,
            recalibration_history,
            is_recalibrated_same_day;


    // ------------------------------------------------------------
    // 6. ENRICH BASE ORDERS
    // ------------------------------------------------------------

    orders_base

    // Recalibration information
    | join kind=leftouter (recal_info) on ordered_id
    | project-away ordered_id1

    | extend
        is_recalibrated_same_day =
            coalesce(is_recalibrated_same_day, "No"),
        recalibration_history =
            coalesce(recalibration_history, "")

    // Shipment and container information
    | join kind=leftouter (containers) on
        $left.ship_container_id == $right.ship_container_id,
        $left.location_guid == $right.location_guid

    | join kind=leftouter (shipments) on
        $left.delivered_shipment_id == $right.shipment_id,
        $left.location_guid == $right.location_guid

    // Current order reason
    | join kind=leftouter (current_reason) on
        $left.ordered_id == $right.reason_ordered_id,
        $left.location_guid == $right.location_guid

    // Dimension lookups
    | lookup kind=leftouter sites on location_guid
    | lookup kind=leftouter products on product_id
    | lookup kind=leftouter clients on client_id

    // Apply pharmacy, client, and product filters before
    // processing redirect relationships.

    | where
        (_pharmacy == "" or location_name in (_pharmacy_list))
        and (_client == "" or client_name in (_client_list))
        and (_product == "" or product_name in (_product_list))


    // ------------------------------------------------------------
    // 7. REDIRECT INFORMATION
    // ------------------------------------------------------------

    | join kind=leftouter orderedredirect_sent on
        $left.ordered_id == $right.sent_ordered_id

    | join kind=leftouter orderedredirect_received on
        $left.ordered_id == $right.exchanged_id

    | join kind=leftouter ordered_link_redirect_sent on
        $left.sent_exchanged_id == $right.link_redirect_sent_ordered_id

    | join kind=leftouter ordered_link_redirect_received on
        $left.received_ordered_id == $right.link_redirect_received_ordered_id

    | lookup kind=leftouter redirect_received_sites
        on link_redirect_received_location_guid

    | lookup kind=leftouter redirect_sent_sites
        on link_redirect_sent_location_guid

    // Consolidate redirect information.
    // Use consistent precedence for date and time.

    | extend
        redirect_facility_name =
            coalesce(sent_facility_name, received_facility_name),

        redirect_calibration_dt =
            coalesce(
                link_redirect_sent_calibration_dt,
                link_redirect_received_calibration_dt
            )


    // ------------------------------------------------------------
    // 8. ORDER STATUS
    // ------------------------------------------------------------

    | extend order_status = case(
        filled == 0 and is_deleted == false and isnull(ship_date),
            "Unfilled",
        is_deleted == true,
            "Deleted",
        client_bill_id == 0 and isnotnull(delivered_date),
            "Redirected Received Delivered",
        isnotnull(delivered_date),
            "Delivered",
        client_bill_id == 0 and isnotnull(ship_date),
            "Redirected Received Shipped",
        processed == -2 and isnull(redirect_calibration_dt),
            "Redirected Sent Unfilled",
        processed == -2,
            "Redirected Sent Shipped",
        isnotnull(ship_date),
            "Shipped",
        filled == 1 and is_deleted == false,
            "Filled",
        "Unknown"
    )


    // ------------------------------------------------------------
    // 9. DELIVERY AND REDIRECT CALCULATIONS
    // ------------------------------------------------------------

    | extend late_minutes =
        datetime_diff(
            'minute',
            delivered_date + delivered_time,
            calibration_date + calibration_time
        )

    | extend final_redirect_ordered_id = case(
        order_status == "Redirected Received Shipped",
            received_ordered_id,
        order_status == "Redirected Sent Shipped",
            sent_exchanged_id,
        order_status == "Redirected Received Delivered",
            received_ordered_id,
        long(null)
    )

    // Compare complete calibration datetimes rather than
    // comparing time components alone.

    | extend is_redirect_recalibrated = case(
        isnull(redirect_calibration_dt),
            "",
        redirect_calibration_dt == calibration_dt,
            "No",
        "Yes"
    )


    // ------------------------------------------------------------
    // 10. ORDER STATUS FILTER
    // ------------------------------------------------------------

    | where
        _order_status == ""
        or order_status in (_order_status_list)


    // ------------------------------------------------------------
    // 11. FINAL OUTPUT
    // ------------------------------------------------------------

    | project
        ["Rx Number"] = tostring(ordered_id),
        ["Order Status"] = order_status,
        ["Pharmacy"] = location_name,
        ["Product"] = product_name,
        ["Client"] = client_name,
        ["Reason Code"] = code,
        ["Reason"] = description,
        ["ReasonDT"] = reason_dt,
        ["Dose Activity"] = actual_activity,

        ["Cal Date"] =
            format_datetime(calibration_date, 'yyyy-MM-dd'),
        ["Cal Time"] = calibration_time,
        ["Order Date"] =
            format_datetime(order_date, 'yyyy-MM-dd'),
        ["Order Time"] = order_time,
        ["Filled Date"] =
            format_datetime(filled_date, 'yyyy-MM-dd'),
        ["Filled Time"] = filled_time,
        ["Packed Date"] =
            format_datetime(packed_date, 'yyyy-MM-dd'),
        ["Packed Time"] = packed_time,
        ["Shipped Date"] =
            format_datetime(ship_date, 'yyyy-MM-dd'),
        ["Shipped Time"] = ship_time,
        ["Delivered Date"] =
            format_datetime(delivered_date, 'yyyy-MM-dd'),
        ["Delivered Time"] = delivered_time,
        ["Delivery Late Minutes"] = late_minutes,

        ["Redirect Rx Number"] =
            tostring(final_redirect_ordered_id),
        ["Redirect Pharmacy"] = redirect_facility_name,
        ["Redirect Cal Date"] =
            format_datetime(redirect_calibration_dt, 'yyyy-MM-dd'),
        ["Redirect Cal Time"] = format_datetime(redirect_calibration_dt, 'HH:mm:ss'),
        ["Is Redirect Recalibrated"] = is_redirect_recalibrated,

        ["Is Recalibrated"] = is_recalibrated,
        ["Is Recalibrated Same Day"] = is_recalibrated_same_day,
        ["Recalibration History"] = recalibration_history
    | sort by
        ["Pharmacy"] asc,
        ["Cal Date"] desc,
        ["Cal Time"] desc
}