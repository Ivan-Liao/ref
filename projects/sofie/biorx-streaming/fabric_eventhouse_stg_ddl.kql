// ============================================================
// STG: locations
// ============================================================

.create table stg_locations_flat
(
    cdc_operation: string,
    cdc_event_datetime: datetime,
    source_event_datetime: datetime,
    ts_ns: long,
    is_deleted: bool,

    location_guid: string,
    location_name: string,
    location_ip_address: string,
    location_database_port: int,
    location_database_name: string,
    location_database_user_name: string,
    location_database_password: string,
    local_database_name: string,
    local_database_user_name: string,
    local_database_password: string,
    deleted: int,
    local_ip_address: string,
    synced: int,
    rabbit_port_to_pharmacy: int,
    rabbit_port_to_master: int,
    mysql_port_to_pharmacy: int,
    mysql_port_to_master: int,
    is_retired_db: int
)

.create-or-alter function with
(
    folder = "CDC",
    docstring = "Flattens raw_locations MariaDB CDC payloads"
)
func_stg_locations_flat()
{
    raw_locations
    | extend p = todynamic(payload)
    | where tostring(p.source.table) == "locations"
    | where tostring(p.op) in ("r", "c", "u", "d")
    | extend row_data = coalesce(
        todynamic(p.after),
        todynamic(p.before)
    )
    | project
        cdc_operation = tostring(p.op),

        cdc_event_datetime =
            unixtime_milliseconds_todatetime(
                tolong(p.ts_ms)
            ),

        source_event_datetime =
            unixtime_milliseconds_todatetime(
                tolong(p.source.ts_ms)
            ),

        ts_ns = coalesce(
            tolong(p.ts_ns),
            tolong(p.ts_ms) * 1000000
        ),

        is_deleted =
            tostring(p.op) == "d"
            or toint(row_data.Deleted) == 1,

        location_guid = tostring(row_data.LocationGUID),
        location_name = tostring(row_data.LocationName),
        location_ip_address = tostring(row_data.LocationIPAddress),
        location_database_port = toint(row_data.LocationDatabasePort),
        location_database_name = tostring(row_data.LocationDatabaseName),
        location_database_user_name = tostring(row_data.LocationDatabaseUserName),
        location_database_password = tostring(row_data.LocationDatabasePassword),
        local_database_name = tostring(row_data.LocalDatabaseName),
        local_database_user_name = tostring(row_data.LocalDatabaseUserName),
        local_database_password = tostring(row_data.LocalDatabasePassword),
        deleted = toint(row_data.Deleted),
        local_ip_address = tostring(row_data.LocalIPAddress),
        synced = toint(row_data.Synced),
        rabbit_port_to_pharmacy = toint(row_data.RabbitPortToPharmacy),
        rabbit_port_to_master = toint(row_data.RabbitPortToMaster),
        mysql_port_to_pharmacy = toint(row_data.MySQLPortToPharmacy),
        mysql_port_to_master = toint(row_data.MySQLPortToMaster),
        is_retired_db = toint(row_data.IsRetiredDB)
}


